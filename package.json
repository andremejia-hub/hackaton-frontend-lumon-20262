{
  "name": "lumon-orientation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run src build",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format": "prettier --write src tests build scripts vite.config.ts playwright.config.ts tsconfig.json package.json index.html vercel.json hackathon.json",
    "format:check": "prettier --check src tests build scripts vite.config.ts playwright.config.ts tsconfig.json package.json index.html vercel.json hackathon.json",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
